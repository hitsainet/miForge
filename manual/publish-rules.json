{
  "_comment": [
    "What may be published from manual/ to the public mirror and to GitHub Pages, in ONE place.",
    "Read by backend/tests/unit/test_manual_publish_allowlist.py (the tracked sources) and by",
    "scripts/check-published.mjs (the BUILT site, after every build). Patterns are regular",
    "expressions valid in both Python and JavaScript. Category 'secret' rules also run over",
    "docs/mcp-contract.md, which the mirror publishes and the build copies into the site."
  ],
  "allowed_files": [
    "manual/.gitignore",
    "manual/README.md",
    "manual/package.json",
    "manual/package-lock.json",
    "manual/tsconfig.json",
    "manual/docusaurus.config.ts",
    "manual/sidebars.ts",
    "manual/publish-rules.json",
    "manual/docs/*.md",
    "manual/docs/*/*.md",
    "manual/src/css/*.css",
    "manual/static/img/*.svg",
    "manual/static/img/*.png",
    "manual/static/img/*.jpg",
    "manual/scripts/*.mjs"
  ],
  "forbidden": [
    {"id": "internal-host", "category": "secret", "pattern": "\\b[a-z0-9-]+\\.(?:hitsai\\.local|hitsai\\.net|local|lan|internal|home\\.arpa)\\b", "flags": "i",
     "why": "An internal or deployment-specific host name. Use example.com in examples."},
    {"id": "private-ipv4", "category": "secret", "pattern": "\\b(?:10\\.\\d{1,3}|192\\.168|172\\.(?:1[6-9]|2\\d|3[01])|100\\.(?:6[4-9]|[7-9]\\d|1[01]\\d|12[0-7]))\\.\\d{1,3}\\.\\d{1,3}\\b", "flags": "",
     "why": "An address on a private network."},
    {"id": "gpu-uuid", "category": "secret", "pattern": "GPU-[0-9a-f]{8}-[0-9a-f]{4}", "flags": "i",
     "why": "A real graphics card's identifier. Write GPU-… instead."},
    {"id": "node-name", "category": "secret", "pattern": "mcs-lnx", "flags": "i",
     "why": "An internal machine name."},
    {"id": "github-token", "category": "secret", "pattern": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}", "flags": "",
     "why": "A GitHub token."},
    {"id": "hf-token", "category": "secret", "pattern": "\\bhf_[A-Za-z0-9]{20,}", "flags": "",
     "why": "A Hugging Face token."},
    {"id": "api-key", "category": "secret", "pattern": "\\bsk-[A-Za-z0-9_-]{20,}|\\bAKIA[0-9A-Z]{16}\\b|\\bxox[abposr]-[A-Za-z0-9-]{10,}", "flags": "",
     "why": "An API key."},
    {"id": "private-key", "category": "secret", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----", "flags": "",
     "why": "A private key."},
    {"id": "home-path", "category": "secret", "pattern": "/home/[a-z]", "flags": "",
     "why": "A path on someone's workstation."},
    {"id": "private-org", "category": "secret", "pattern": "onegaishimas", "flags": "i",
     "why": "The private source organisation; the public mirror is hitsainet."},
    {"id": "planning-tree", "category": "internal", "pattern": "0xcc|\\bAGENT\\.md\\b|\\bCLAUDE\\.md\\b|\\bGEMINI\\.md\\b", "flags": "",
     "why": "Internal planning documents and agent memory, which the mirror strips."},
    {"id": "requirement-id", "category": "internal", "pattern": "\\bR-0\\d\\.\\d|\\bBRD-|\\b(?:PPRD|PADR|FPRD|FTDD|FTID|FTASKS)\\b|\\bADR-\\d|\\bMIS-E2E|\\bFR-0\\d\\d\\.", "flags": "",
     "why": "Internal requirement and review identifiers mean nothing to a reader of the manual."},
    {"id": "decision-id", "category": "internal", "pattern": "\\(D\\d{1,2}\\)|\\bfeature 0\\d\\d\\b|\\bF\\d{1,2}'s\\b", "flags": "",
     "why": "Internal decision and feature numbers."}
  ]
}
