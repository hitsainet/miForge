# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo

# Environment & secrets
.env
.env.*
# ...but the TEMPLATE must be tracked. `.env.*` matches `.env.example`, so without
# this negation foundation task 9.4's file is silently never committed and a clean
# clone has nothing to copy (task 10.1 requires no manual step beyond `.env`).
# miDataworks carries the same negation for the same reason.
!.env.example

# Logs
*.log

# Local artifact roots. `.env.example` points CHECKPOINT_ROOT, TRAINER_STATE_ROOT
# and PARTS_ROOT here for development; the production paths are /data/* on the
# volumes in gitops/pilot/storage.yaml.
.local-data/

# Common dependency/build directories
node_modules/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/

# Local dev virtualenv (ADR-023: docker-compose is the shared dev path)
.venv/

# Editable-install metadata, generated by `pip install -e .` (foundation 10.1).
*.egg-info/
